# ── LLM Provider (Groq Free Tier) ──────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Qdrant Vector Database ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=accounting_kb

# ── Model Configuration ────────────────────────────────────────
# Used for contextual chunk enrichment (fast, cheap)
CONTEXT_MODEL=llama-3.1-8b-instant
# Used for the main agent reasoning (smarter)
AGENT_MODEL=llama-3.3-70b-versatile

# ── Embedding Models (local, via fastembed) ────────────────────
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# ── Retrieval Tuning ──────────────────────────────────────────
HYBRID_TOP_K=20
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
